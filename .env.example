# DwellIQ Environment Configuration
# Copy this file to .env and configure local settings

APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secure_hex_key_for_production
STREAMLIT_SERVER_PORT=8501
DB_PATH=data/secure/users.db
PBKDF2_ITERATIONS=200000
RATE_LIMIT_WINDOW_SEC=300
MAX_FAILED_ATTEMPTS=5
