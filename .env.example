# DwellIQ Configuration Variables

# AI Advisor Configuration (Optional)
# If provided, DwellIQ AI connects to live LLMs for adaptive reasoning.
# If omitted or left blank, DwellIQ automatically activates its built-in
# deterministic domain knowledge and financial calculation engine.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Application Security & Database Settings
APP_ENV="development"
DB_PATH="data/secure/users.db"
PBKDF2_ITERATIONS=200000
RATE_LIMIT_WINDOW_SEC=300
MAX_FAILED_ATTEMPTS=5
